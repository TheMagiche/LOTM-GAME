{
  "name": "narrative-engine",
  "private": true,
  "version": "2.0.0",
  "description": "Lord of the Mysteries — local-first AI narrative RPG",
  "author": "TheMagiche",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:lan": "node scripts/start-dev.mjs --lan",
    "dev:demo": "node scripts/start-dev.mjs --demo",
    "build": "tsc -b && vite build",
    "build:demo": "vite build --mode demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:base-app-gate": "vitest run src/services/turn/__tests__/baseAppGate/baseAppGate.test.ts",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/i18n-check.mjs",
    "lore:compile": "node scripts/compile-lotm-lore.mjs",
    "build:server": "node build-server.mjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3,sqlite-vec,onnxruntime-node,sharp",
    "electron:pack:mac": "npx vite build && npm run build:server && npm run electron:rebuild && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "electron:pack:win": "npx vite build && npm run build:server && npm run electron:rebuild && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "electron:pack:linux": "npx vite build && npm run build:server && npm run electron:rebuild && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@narrative/engine": "file:packages/engine",
    "@tailwindcss/typography": "^0.5.19",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "idb-keyval": "^6.2.2",
    "js-tiktoken": "^1.0.21",
    "kokoro-js": "^1.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.564.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "^0.1.9",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.8",
    "concurrently": "^10.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "onnxruntime-node": "1.23.2",
    "shell-quote": "^1.9.0",
    "sharp": "^0.35.3",
    "tar": "^7.5.21",
    "minimatch": "^10.0.3"
  }
}
